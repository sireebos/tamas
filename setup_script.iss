; Script generated by Antigravity for RestaurantManager
#define MyAppName "RestaurantManager"
#define MyAppVersion "2.3.0"
#define MyAppPublisher "YourName"
#define MyAppExeName "RestaurantManager.exe"

[Setup]
AppId={{7B3A2C1D-E4F5-4G6H-8I9J-0K1L2M3N4O5P}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
; Output location for the setup file
OutputDir=installer_output
OutputBaseFilename=TamasPalace_Setup_v2.3.0
Compression=lzma
SolidCompression=yes
WizardStyle=modern
SetupIconFile=app.ico

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Source is the publish folder we just created
Source: "publish\v2.3.0\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "publish\v2.3.0\RestaurantManager.pdb"; DestDir: "{app}"; Flags: ignoreversion
; Add database if you want to include a fresh one, but usually it's created on first run
; Source: "RestaurantManager.db"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
