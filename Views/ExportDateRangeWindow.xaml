<Window x:Class="RestaurantManager.Views.ExportDateRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Date Range" Width="440" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f8fafc">

    <Window.Resources>
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,18,24,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#667eea" Offset="0"/>
                    <GradientStop Color="#764ba2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="📥 Export Report" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Choose a date range to export" FontSize="11" Foreground="#ffffffaa" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="✕" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#ffffffcc"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="24,18,24,18">
            <TextBlock Text="📅 DATE RANGE" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="BtnYesterday" Content="Yesterday" Style="{StaticResource PillBtn}" Tag="yesterday" Click="DateFilter_Click" Margin="0,0,6,6"/>
                <Button x:Name="BtnToday" Content="Today" Style="{StaticResource PillBtn}" Tag="today" Click="DateFilter_Click" Margin="0,0,6,6"/>
                <Button x:Name="BtnWeek" Content="This Week" Style="{StaticResource PillBtn}" Tag="week" Click="DateFilter_Click" Margin="0,0,6,6"/>
                <Button x:Name="BtnMonth" Content="This Month" Style="{StaticResource PillBtn}" Tag="month" Click="DateFilter_Click" Margin="0,0,6,6"/>
                <Button x:Name="BtnCustom" Content="Custom Range" Style="{StaticResource PillBtn}" Tag="custom" Click="DateFilter_Click" Margin="0,0,0,6"/>
            </WrapPanel>

            <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="From:" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="DateFromPicker" Width="140" FontSize="12" SelectedDateChanged="CustomDate_Changed"/>
                <TextBlock Text="  To:" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="8,0,6,0"/>
                <DatePicker x:Name="DateToPicker" Width="140" FontSize="12" SelectedDateChanged="CustomDate_Changed"/>
            </StackPanel>

            <Border Background="#f0fdf4" CornerRadius="8" Padding="12,8" Margin="0,0,0,0">
                <TextBlock x:Name="PeriodLabel" Text="Today" FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,14" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="Cancel" Background="#f1f5f9" Foreground="#64748b" BorderThickness="0" Padding="20,10"
                        FontSize="13" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Left" Click="Close_Click"/>
                <Button Padding="20,10" FontSize="13" FontWeight="Bold"
                        Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="Export_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ExportIcon" Text="📥" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ExportLabel" Text="Export CSV" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
