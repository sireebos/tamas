<Window x:Class="RestaurantManager.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Preview" Width="420" Height="650"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#f1f5f9"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="White" Padding="16,12" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="🧾 Receipt Preview" FontSize="16" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>
                <TextBlock x:Name="OrderNumberLabel" Text="" FontSize="12" Foreground="#64748b" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Receipt Content -->
        <Border Grid.Row="1" Margin="24,16,24,8" Background="White" CornerRadius="4" Padding="0"
                BorderBrush="#d1d5db" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Color="#000" Opacity="0.08"/>
            </Border.Effect>
            <FlowDocumentScrollViewer x:Name="ReceiptViewer" VerticalScrollBarVisibility="Auto"
                                      IsToolBarVisible="False"/>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="White" Padding="16,12" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Padding="20,10" FontSize="13" Margin="0,0,10,0"
                        Background="#e2e8f0" Foreground="#475569" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="🖨 Print" Padding="20,10" FontSize="13" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="Print_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
