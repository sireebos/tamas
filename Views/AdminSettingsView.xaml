<UserControl x:Class="RestaurantManager.Views.AdminSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f0f2f5">

    <UserControl.Resources>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SettingsInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="16" Color="#000" Opacity="0.07"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,1,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="12" Color="#000" Opacity="0.04" Direction="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <Border Grid.Row="0" Padding="20,24,20,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border CornerRadius="12" Width="42" Height="42" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#667eea" Offset="0"/>
                                        <GradientStop Color="#764ba2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#0f172a"/>
                                <TextBlock Text="Admin Panel" FontSize="11" Foreground="#94a3b8"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Divider -->
                        <Border Height="1" Background="#f1f5f9" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Sidebar Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="Both" Padding="12,0,12,12">
                    <StackPanel>
                        <!-- Section: Appearance -->
                        <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="Bold" Foreground="#94a3b8" Margin="12,4,0,10"/>
                        <Button x:Name="TabBranding" Style="{StaticResource TabBtn}" Click="TabBranding_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Branding" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabLoginForm" Style="{StaticResource TabBtn}" Click="TabLoginForm_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔐" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Login Screen" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabTheme" Style="{StaticResource TabBtn}" Click="TabTheme_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Theme Colors" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabReceipt" Style="{StaticResource TabBtn}" Click="TabReceipt_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Receipt" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section: Business -->
                        <TextBlock Text="BUSINESS" FontSize="10" FontWeight="Bold" Foreground="#94a3b8" Margin="12,20,0,10"/>
                        <Button x:Name="TabCurrency" Style="{StaticResource TabBtn}" Click="TabCurrency_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💱" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Currency" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section: Team -->
                        <TextBlock Text="TEAM" FontSize="10" FontWeight="Bold" Foreground="#94a3b8" Margin="12,20,0,10"/>
                        <Button x:Name="TabUsers" Style="{StaticResource TabBtn}" Click="TabUsers_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Users" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabDepartments" Style="{StaticResource TabBtn}" Click="TabDepartments_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏢" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Departments" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabCategories" Style="{StaticResource TabBtn}" Click="TabCategories_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Categories" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabOrderSettings" Style="{StaticResource TabBtn}" Click="TabOrderSettings_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Order Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabSidebarWelcome" Style="{StaticResource TabBtn}" Click="TabSidebarWelcome_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sidebar &amp; Welcome" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section: Advanced -->
                        <TextBlock x:Name="SidebarAdvancedLabel" Text="ADVANCED" FontSize="10" FontWeight="Bold" Foreground="#94a3b8" Margin="12,20,0,10" Visibility="Collapsed"/>
                        <Button x:Name="TabDeveloper" Style="{StaticResource TabBtn}" Click="TabDeveloper_Click" HorizontalContentAlignment="Left" Padding="14,0,14,0" Margin="0,0,0,2"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔧" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Developer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer with Save/Reset -->
                <Border Grid.Row="2" Padding="16,12,16,16" BorderBrush="#f1f5f9" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Button x:Name="SaveBtn" Click="SaveBtn_Click" Style="{StaticResource SaveBtn}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save All Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="ResetBtn_Click" Style="{StaticResource SaveBtn}" Background="#ef4444" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↺" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Reset Defaults" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="StatusMessage" FontSize="11" Foreground="#22c55e" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT AREA ═══ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" PanningMode="Both" Padding="0">
            <StackPanel Margin="40,32,40,40" HorizontalAlignment="Stretch">

                <!-- ═══════ BRANDING TAB ═══════ -->
                <StackPanel x:Name="BrandingPanel">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Login Screen Branding" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                                    <TextBlock Text="These settings control what appears on the login splash screen" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Background="#f0f4ff" CornerRadius="10" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="🎨" FontSize="18"/>
                                </Border>
                            </Grid>

                            <!-- Logo -->
                            <TextBlock Text="LOGO" Style="{StaticResource SettingsLabel}"/>
                            <Border Background="#f8fafc" CornerRadius="14" Padding="20" Margin="0,0,0,20" BorderBrush="#e2e8f0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="16" Margin="0,0,16,0" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#667eea" Offset="0"/>
                                                <GradientStop Color="#764ba2" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <TextBlock x:Name="LogoPreview" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="LogoImagePreview" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Fallback Emoji (used when no image is set)" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,6"/>
                                        <TextBox x:Name="LogoEmojiBox" Style="{StaticResource SettingsInput}" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📁  Upload Logo" Click="UploadLogo_Click"
                                                    Height="36" Padding="18,0" FontSize="12" FontWeight="SemiBold"
                                                    Style="{StaticResource SaveBtn}">
                                                <Button.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#667eea" Offset="0"/>
                                                        <GradientStop Color="#764ba2" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Button.Background>
                                            </Button>
                                            <Button x:Name="RemoveLogoBtn" Content="✕  Remove" Click="RemoveLogo_Click"
                                                    Height="36" Padding="18,0" FontSize="12" FontWeight="SemiBold"
                                                    Style="{StaticResource SaveBtn}" Background="#ef4444"
                                                    Margin="8,0,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LogoPathLabel" Text="" FontSize="10" Foreground="#94a3b8" Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="BUSINESS NAME — LINE 1 (spaced heading)" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="NameLine1Box" Style="{StaticResource SettingsInput}"/>

                            <TextBlock Text="BUSINESS NAME — LINE 2 (large title)" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="NameLine2Box" Style="{StaticResource SettingsInput}"/>

                            <TextBlock Text="TAGLINE" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="TaglineBox" Style="{StaticResource SettingsInput}"/>

                            <TextBlock Text="DESCRIPTION" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="DescriptionBox" Style="{StaticResource SettingsInput}" 
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>

                            <TextBlock Text="COPYRIGHT TEXT" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="CopyrightBox" Style="{StaticResource SettingsInput}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ LOGIN FORM TAB ═══════ -->
                <StackPanel x:Name="LoginFormPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Login Form Text" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                                    <TextBlock Text="Customize the welcome text shown on the right side of the login screen" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Background="#fef2f2" CornerRadius="10" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="🔐" FontSize="18"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="WINDOW TITLE" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="WindowTitleBox" Style="{StaticResource SettingsInput}"/>

                            <TextBlock Text="WELCOME HEADING" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="WelcomeTitleBox" Style="{StaticResource SettingsInput}"/>

                            <TextBlock Text="WELCOME SUBTITLE" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="WelcomeSubtitleBox" Style="{StaticResource SettingsInput}" Margin="0,0,0,20"/>

                            <!-- Quick Login Toggle -->
                            <Border Background="#f8fafc" CornerRadius="14" Padding="18,14" BorderBrush="#e2e8f0" BorderThickness="1">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Show Quick Login Accounts" FontSize="14" FontWeight="SemiBold" Foreground="#0f172a"/>
                                        <TextBlock Text="Display user quick-login buttons below the login form" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowDemoLoginToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Content="  Enabled" FontSize="13" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ CURRENCY TAB ═══════ -->
                <StackPanel x:Name="CurrencyPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Currency Settings" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                                    <TextBlock Text="Configure how currency values are displayed throughout the application" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Background="#f0fdf4" CornerRadius="10" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="💱" FontSize="18"/>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Currency Symbol -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="CURRENCY SYMBOL" Style="{StaticResource SettingsLabel}"/>
                                    <TextBox x:Name="CurrencySymbolBox" Style="{StaticResource SettingsInput}" TextChanged="Currency_Changed"/>
                                </StackPanel>

                                <!-- Currency Code -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="CURRENCY CODE" Style="{StaticResource SettingsLabel}"/>
                                    <TextBox x:Name="CurrencyCodeBox" Style="{StaticResource SettingsInput}" TextChanged="Currency_Changed"/>
                                </StackPanel>

                                <!-- Position -->
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="SYMBOL POSITION" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox x:Name="CurrencyPositionBox" Padding="14,11" FontSize="14" 
                                              Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5" Margin="0,0,0,20"
                                              SelectionChanged="Currency_Changed">
                                        <ComboBoxItem Content="Before amount (R 100)" Tag="before"/>
                                        <ComboBoxItem Content="After amount (100 R)" Tag="after"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Decimal Places -->
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="DECIMAL PLACES" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox x:Name="DecimalPlacesBox" Padding="14,11" FontSize="14"
                                              Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5" Margin="0,0,0,20"
                                              SelectionChanged="Currency_Changed">
                                        <ComboBoxItem Content="0" Tag="0"/>
                                        <ComboBoxItem Content="1" Tag="1"/>
                                        <ComboBoxItem Content="2" Tag="2"/>
                                        <ComboBoxItem Content="3" Tag="3"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Thousands Separator -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="THOUSANDS SEPARATOR" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox x:Name="ThousandsSepBox" Padding="14,11" FontSize="14"
                                              Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5" Margin="0,0,0,20"
                                              SelectionChanged="Currency_Changed">
                                        <ComboBoxItem Content="Comma (1,000)" Tag=","/>
                                        <ComboBoxItem Content="Period (1.000)" Tag="."/>
                                        <ComboBoxItem Content="Space (1 000)" Tag=" "/>
                                        <ComboBoxItem Content="None (1000)" Tag=""/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Decimal Separator -->
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="DECIMAL SEPARATOR" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox x:Name="DecimalSepBox" Padding="14,11" FontSize="14"
                                              Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5" Margin="0,0,0,20"
                                              SelectionChanged="Currency_Changed">
                                        <ComboBoxItem Content="Period (0.00)" Tag="."/>
                                        <ComboBoxItem Content="Comma (0,00)" Tag=","/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Live Preview -->
                            <Border Margin="0,8,0,0" CornerRadius="14" Padding="24,20" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#667eea" Offset="0"/>
                                        <GradientStop Color="#764ba2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="LIVE PREVIEW" FontSize="10" Foreground="#ffffffaa" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="CurrencyPreview" Text="R 1,234.56" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CurrencyCodePreview" Text="ZAR" FontSize="13" Foreground="#ffffffbb" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Common Presets -->
                            <TextBlock Text="QUICK PRESETS" Style="{StaticResource SettingsLabel}" Margin="0,20,0,8"/>
                            <WrapPanel>
                                <Button Content="🇿🇦 ZAR (R)" Tag="ZAR" Click="CurrencyPreset_Click" Style="{StaticResource TabBtn}" Margin="0,0,8,8"/>
                                <Button Content="🇺🇸 USD ($)" Tag="USD" Click="CurrencyPreset_Click" Style="{StaticResource TabBtn}" Margin="0,0,8,8"/>
                                <Button Content="🇪🇺 EUR (€)" Tag="EUR" Click="CurrencyPreset_Click" Style="{StaticResource TabBtn}" Margin="0,0,8,8"/>
                                <Button Content="🇬🇧 GBP (£)" Tag="GBP" Click="CurrencyPreset_Click" Style="{StaticResource TabBtn}" Margin="0,0,8,8"/>
                                <Button Content="🇯🇵 JPY (¥)" Tag="JPY" Click="CurrencyPreset_Click" Style="{StaticResource TabBtn}" Margin="0,0,8,8"/>
                                <Button Content="🇳🇬 NGN (₦)" Tag="NGN" Click="CurrencyPreset_Click" Style="{StaticResource TabBtn}" Margin="0,0,8,8"/>
                                <Button Content="🇮🇳 INR (₹)" Tag="INR" Click="CurrencyPreset_Click" Style="{StaticResource TabBtn}" Margin="0,0,8,8"/>
                                <Button Content="🇧🇷 BRL (R$)" Tag="BRL" Click="CurrencyPreset_Click" Style="{StaticResource TabBtn}" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ THEME COLORS TAB ═══════ -->
                <StackPanel x:Name="ThemePanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Card Theme Colors" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
