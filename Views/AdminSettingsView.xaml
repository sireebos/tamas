                                <Border Background="#f0f4ff" CornerRadius="10" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="📦" FontSize="18"/>
                                </Border>
                            </Grid>

                            <!-- Product Card Size -->
                            <Border Background="#f8fafc" CornerRadius="14" Padding="24" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="ORDER PRODUCT CARD SIZE" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock Text="Control the size of product/menu item cards in the Orders view" FontSize="12" Foreground="#94a3b8" Margin="0,0,0,16"/>

                                    <WrapPanel Margin="0,0,0,16">
                                        <!-- Small option -->
                                        <Border x:Name="CardSizeSmall" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,10"
                                                BorderBrush="#e2e8f0" BorderThickness="1.5" Cursor="Hand"
                                                MouseLeftButtonDown="CardSizeOption_Click" Tag="small">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="45" Height="30" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="📦" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Small" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Medium option -->
                                        <Border x:Name="CardSizeMedium" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,10"
                                                BorderBrush="#667eea" BorderThickness="2" Cursor="Hand"
                                                MouseLeftButtonDown="CardSizeOption_Click" Tag="medium">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="50" Height="38" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="📦" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Medium" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Large option -->
                                        <Border x:Name="CardSizeLarge" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,10"
                                                BorderBrush="#e2e8f0" BorderThickness="1.5" Cursor="Hand"
                                                MouseLeftButtonDown="CardSizeOption_Click" Tag="large">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="55" Height="44" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Large" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- XLarge option -->
                                        <Border x:Name="CardSizeXLarge" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,10"
                                                BorderBrush="#e2e8f0" BorderThickness="1.5" Cursor="Hand"
                                                MouseLeftButtonDown="CardSizeOption_Click" Tag="xlarge">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="60" Height="50" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="X-Large" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- XXLarge option -->
                                        <Border x:Name="CardSizeXXLarge" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                                                BorderBrush="#e2e8f0" BorderThickness="1.5" Cursor="Hand"
                                                MouseLeftButtonDown="CardSizeOption_Click" Tag="xxlarge">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="66" Height="56" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="XX-Large" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- XXXLarge option -->
                                        <Border x:Name="CardSizeXXXLarge" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                                                BorderBrush="#e2e8f0" BorderThickness="1.5" Cursor="Hand"
                                                MouseLeftButtonDown="CardSizeOption_Click" Tag="xxxlarge">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="72" Height="62" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="📦" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="XXX-Large" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Font Settings Row -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Font Size -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="FONT SIZE" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CardFontSizeBox" FontSize="13" Padding="8,6" SelectionChanged="CardFontSize_Changed">
                                                <ComboBoxItem Content="Auto (based on card size)" Tag="0"/>
                                                <ComboBoxItem Content="10 px" Tag="10"/>
                                                <ComboBoxItem Content="12 px" Tag="12"/>
                                                <ComboBoxItem Content="14 px" Tag="14"/>
                                                <ComboBoxItem Content="16 px" Tag="16"/>
                                                <ComboBoxItem Content="18 px" Tag="18"/>
                                                <ComboBoxItem Content="20 px" Tag="20"/>
                                                <ComboBoxItem Content="22 px" Tag="22"/>
                                                <ComboBoxItem Content="24 px" Tag="24"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Font Weight -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="FONT WEIGHT" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CardFontWeightBox" FontSize="13" Padding="8,6" SelectionChanged="CardFontWeight_Changed">
                                                <ComboBoxItem Content="Normal" Tag="Normal"/>
                                                <ComboBoxItem Content="Semi-Bold" Tag="SemiBold"/>
                                                <ComboBoxItem Content="Bold" Tag="Bold"/>
                                                <ComboBoxItem Content="Extra Bold" Tag="ExtraBold"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#eff6ff" CornerRadius="8" Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Larger cards are easier to tap on touch screens. Font size 'Auto' adjusts based on card size." FontSize="11" Foreground="#64748b" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Category Tab Size -->
                            <Border Background="#f8fafc" CornerRadius="14" Padding="24" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="CATEGORY TAB SIZE" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock Text="Control the size of category tabs in the Orders view" FontSize="12" Foreground="#94a3b8" Margin="0,0,0,16"/>

                                    <WrapPanel>
                                        <!-- Small -->
                                        <Border x:Name="CatTabSizeSmall" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,10"
                                                BorderBrush="#e2e8f0" BorderThickness="1.5" Cursor="Hand"
                                                MouseLeftButtonDown="CatTabSizeOption_Click" Tag="small">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="45" Height="22" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="🏷" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Small" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Medium -->
                                        <Border x:Name="CatTabSizeMedium" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,10"
                                                BorderBrush="#667eea" BorderThickness="2" Cursor="Hand"
                                                MouseLeftButtonDown="CatTabSizeOption_Click" Tag="medium">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="55" Height="28" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="🏷" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Medium" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Large -->
                                        <Border x:Name="CatTabSizeLarge" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,10,10"
                                                BorderBrush="#e2e8f0" BorderThickness="1.5" Cursor="Hand"
                                                MouseLeftButtonDown="CatTabSizeOption_Click" Tag="large">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="65" Height="34" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="🏷" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Large" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- X-Large -->
                                        <Border x:Name="CatTabSizeXLarge" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                                                BorderBrush="#e2e8f0" BorderThickness="1.5" Cursor="Hand"
                                                MouseLeftButtonDown="CatTabSizeOption_Click" Tag="xlarge">
                                            <StackPanel HorizontalAlignment="Center" Width="70">
                                                <Border Background="#f0f4ff" CornerRadius="6" Width="72" Height="40" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="🏷" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="X-Large" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <Border Background="#eff6ff" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Larger category tabs are easier to find and tap on touch screens." FontSize="11" Foreground="#64748b" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="CategoriesPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Category Management" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
                                    <TextBlock Text="Create categories and assign them to departments" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Background="#fef9c3" CornerRadius="10" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="🏷" FontSize="18"/>
                                </Border>
                            </Grid>

                            <!-- Create Category Form -->
                            <Border Background="#f8fafc" CornerRadius="14" Padding="24" Margin="0,0,0,24" BorderBrush="#e2e8f0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CREATE NEW CATEGORY" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CATEGORY NAME" Style="{StaticResource SettingsLabel}"/>
                                            <TextBox x:Name="NewCatName" Style="{StaticResource SettingsInput}" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ICON" Style="{StaticResource SettingsLabel}"/>
                                            <TextBox x:Name="NewCatIcon" Style="{StaticResource SettingsInput}" Margin="0" Text="🏷"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="COLOR" Style="{StaticResource SettingsLabel}"/>
                                            <TextBox x:Name="NewCatColor" Style="{StaticResource SettingsInput}" Margin="0" Text="#667eea"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="＋  Create Category" Click="CreateCat_Click" Style="{StaticResource SaveBtn}" Height="40" Padding="24,0">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#667eea" Offset="0"/>
                                                    <GradientStop Color="#764ba2" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                        </Button>
                                        <TextBlock x:Name="CatStatusMessage" FontSize="12" Foreground="#22c55e" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Categories List -->
                            <TextBlock Text="CATEGORIES" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,12"/>
                            <StackPanel x:Name="CatListPanel"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ CHANGE PASSWORD OVERLAY ═══ -->
        <Grid x:Name="ChangePasswordOverlay" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="#000" Opacity="0.5" MouseDown="ClosePasswordOverlay_Click"/>
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="22" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="10" BlurRadius="40" Color="#000" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="24,18,24,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#f59e0b" Offset="0"/>
                                <GradientStop Color="#d97706" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="🔑 Change Password" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="PwOverlayUserName" Text="" FontSize="11" Foreground="#ffffffaa" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#ffffffcc"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="ClosePasswordOverlay_Click"/>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <Border Grid.Row="1" Background="White" Padding="24,20,24,24">
                        <StackPanel>
                            <TextBlock Text="NEW PASSWORD" Style="{StaticResource SettingsLabel}"/>
                            <PasswordBox x:Name="OverlayNewPassword" FontSize="14" Padding="14,11"
                                         Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5" Margin="0,0,0,16"
                                         PreviewKeyDown="OverlayPassword_KeyDown"/>

                            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource SettingsLabel}"/>
                            <PasswordBox x:Name="OverlayConfirmPassword" FontSize="14" Padding="14,11"
                                         Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5" Margin="0,0,0,20"
                                         PreviewKeyDown="OverlayPassword_KeyDown"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="💾  Save Password" Click="SavePasswordOverlay_Click" Style="{StaticResource SaveBtn}" Height="42" Padding="24,0">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#f59e0b" Offset="0"/>
                                            <GradientStop Color="#d97706" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                                <Button Content="Cancel" Click="ClosePasswordOverlay_Click" Style="{StaticResource SaveBtn}" 
                                        Background="#e2e8f0" Foreground="#475569" Height="42" Padding="24,0" Margin="8,0,0,0"/>
                                <TextBlock x:Name="PwOverlayStatus" FontSize="12" FontWeight="SemiBold" 
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
