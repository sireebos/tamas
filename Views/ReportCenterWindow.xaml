<Window x:Class="RestaurantManager.Views.ReportCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Center" Width="680" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f8fafc">

    <Window.Resources>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Padding="24,18,24,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#667eea" Offset="0"/>
                    <GradientStop Color="#764ba2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel>
                    <TextBlock Text="📊 Report Center" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Generate and print reports" FontSize="11" Foreground="#ffffffaa" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="✕" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#ffffffcc"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- ═══ REPORT TYPE TABS ═══ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="TabEndOfDay" Style="{StaticResource TabBtn}" Click="TabEndOfDay_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="End of Day" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabByCashier" Style="{StaticResource TabBtn}" Click="TabByCashier_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="By Cashier" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabByItem" Style="{StaticResource TabBtn}" Click="TabByItem_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="By Item" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══ BODY ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,18">

                <!-- Date Filter -->
                <TextBlock Text="📅 DATE RANGE" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,10"/>
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="BtnYesterday" Content="Yesterday" Style="{StaticResource PillBtn}" Tag="yesterday" Click="DateFilter_Click" Margin="0,0,6,6"/>
                    <Button x:Name="BtnToday" Content="Today" Style="{StaticResource PillBtn}" Tag="today" Click="DateFilter_Click" Margin="0,0,6,6"/>
                    <Button x:Name="BtnWeek" Content="This Week" Style="{StaticResource PillBtn}" Tag="week" Click="DateFilter_Click" Margin="0,0,6,6"/>
                    <Button x:Name="BtnMonth" Content="This Month" Style="{StaticResource PillBtn}" Tag="month" Click="DateFilter_Click" Margin="0,0,6,6"/>
                    <Button x:Name="BtnCustom" Content="Custom Range" Style="{StaticResource PillBtn}" Tag="custom" Click="DateFilter_Click" Margin="0,0,0,6"/>
                </WrapPanel>

                <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock Text="From:" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DateFromPicker" Width="140" FontSize="12" SelectedDateChanged="CustomDate_Changed"/>
                    <TextBlock Text="  To:" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <DatePicker x:Name="DateToPicker" Width="140" FontSize="12" SelectedDateChanged="CustomDate_Changed"/>
                </StackPanel>

                <Border Background="#f0fdf4" CornerRadius="8" Padding="12,8" Margin="0,0,0,18">
                    <TextBlock x:Name="PeriodLabel" Text="Today" FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
                </Border>

                <!-- ─── Cashier Selector (shown for By Cashier / By Item) ─── -->
                <StackPanel x:Name="CashierSection" Visibility="Collapsed">
                    <TextBlock Text="👤 SELECT CASHIER" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBlock Text="Filter report by a specific cashier" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CashierCombo" FontSize="13" Padding="10,8" Margin="0,0,0,18"
                              SelectionChanged="CashierCombo_Changed"/>
                </StackPanel>

                <!-- ─── Item Selector (shown for By Item) ─── -->
                <StackPanel x:Name="ItemSection" Visibility="Collapsed">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="📦 SELECT ITEM" FontSize="10" FontWeight="Bold" Foreground="#64748b" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                             <TextBlock Text="Sort:" FontSize="10" FontWeight="Bold" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                             <ComboBox x:Name="ItemSortCombo" Width="100" FontSize="10" Padding="4,2" Height="22">
                                 <ComboBoxItem Content="A-Z (Name)" Tag="az" IsSelected="True"/>
                                 <ComboBoxItem Content="Z-A (Name)" Tag="za"/>
                                 <ComboBoxItem Content="Revenue (High)" Tag="rev_desc"/>
                                 <ComboBoxItem Content="Revenue (Low)" Tag="rev_asc"/>
                             </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Choose a specific item or 'All Items'" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,8"/>

                    <TextBox x:Name="ItemSearchBox" Padding="10,8" FontSize="13" Background="White" BorderBrush="#e2e8f0"
                             BorderThickness="1.5" Margin="0,0,0,8" TextChanged="ItemSearch_Changed">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Tag" Value="🔍 Search items..."/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Border Background="White" CornerRadius="10" BorderBrush="#e2e8f0" BorderThickness="1" MaxHeight="200" ClipToBounds="True">
                        <ListBox x:Name="ItemList" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="ItemList_Changed" FontSize="13" Padding="4">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                        Background="Transparent" Margin="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#eff6ff"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3b82f6"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </StackPanel>

                <!-- ─── End of Day summary info ─── -->
                <StackPanel x:Name="EndOfDayInfo" Visibility="Visible">
                    <TextBlock Text="📋 END OF DAY REPORT" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,10"/>
                    <Border Background="#eff6ff" CornerRadius="10" Padding="16,14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="This report includes:" FontSize="13" FontWeight="SemiBold" Foreground="#1e40af" Margin="0,0,0,8"/>
                            <TextBlock Text="• Sales Summary (orders, revenue, averages)" FontSize="12" Foreground="#3b82f6" Margin="0,0,0,4"/>
                            <TextBlock Text="• Payment Methods Breakdown" FontSize="12" Foreground="#3b82f6" Margin="0,0,0,4"/>
                            <TextBlock Text="• Sales by Cashier" FontSize="12" Foreground="#3b82f6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="3" Background="White" Padding="24,14" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="Cancel" Background="#f1f5f9" Foreground="#64748b" BorderThickness="0" Padding="20,10"
                        FontSize="13" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Left" Click="Close_Click"/>
                <Button x:Name="PrintBtn" Padding="20,10" FontSize="13" FontWeight="Bold"
                        Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="Print_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Print Report" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
