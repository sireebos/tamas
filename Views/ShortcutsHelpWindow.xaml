<Window x:Class="RestaurantManager.Views.ShortcutsHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts" Width="480" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f8fafc">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,18,24,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#667eea" Offset="0"/>
                    <GradientStop Color="#764ba2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel>
                    <TextBlock Text="⌨ Keyboard Shortcuts" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Press F12 anytime to show this help" FontSize="11" Foreground="#ffffffaa" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="✕" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#ffffffcc"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- Shortcut List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,14,24,14">
            <StackPanel>

                <!-- Global Navigation -->
                <TextBlock Text="🌐 GLOBAL NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="10" Padding="0" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,0,0,18">
                    <StackPanel>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="Dashboard" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="F1" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="Orders" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="F2" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="Sales History" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="F3" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="Inventory (admin)" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="F4" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10">
                            <Grid><TextBlock Text="Reports (admin)" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="F5" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Orders -->
                <TextBlock Text="🛒 ORDERS VIEW" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="10" Padding="0" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,0,0,18">
                    <StackPanel>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="Place Order / Pay" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="Ctrl + P" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="New Order Tab" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="Ctrl + N" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="New Order Tab" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="Ctrl + T" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="Save Draft" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="Ctrl + S" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="Order History" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="Ctrl + H" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="Search Menu Items" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="Ctrl + F" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                            <Grid><TextBlock Text="Clear Order" Foreground="#334155" FontSize="13"/><Border Background="#fef2f2" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="Ctrl + Del" FontSize="12" FontWeight="Bold" Foreground="#ef4444" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                        <Border Padding="14,10">
                            <Grid><TextBlock Text="Close Overlay / Cancel" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="Esc" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Reports -->
                <TextBlock Text="📊 REPORTS VIEW" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="10" Padding="0" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,0,0,18">
                    <StackPanel>
                        <Border Padding="14,10">
                            <Grid><TextBlock Text="Print End of Day Report" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="Ctrl + P" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Text="ℹ GENERAL" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="10" Padding="0" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Padding="14,10">
                            <Grid><TextBlock Text="Show This Help" Foreground="#334155" FontSize="13"/><Border Background="#f0f4ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="F12" FontSize="12" FontWeight="Bold" Foreground="#667eea" FontFamily="Consolas"/></Border></Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,12" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0">
            <TextBlock Text="Shortcuts are disabled while typing in text fields" FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
