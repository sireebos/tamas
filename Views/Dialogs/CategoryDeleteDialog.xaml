<Window x:Class="RestaurantManager.Views.Dialogs.CategoryDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Category" Height="620" Width="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f0f2f5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,18,24,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#ef4444" Offset="0"/>
                    <GradientStop Color="#dc2626" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🗑 Delete Category" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="HeaderSubtitle" Text="" FontSize="12" Foreground="#ffffffbb" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Background="White" VerticalScrollBarVisibility="Auto">
            <Border Padding="24,20,24,16">
                <StackPanel>
                    <!-- Item Count Info -->
                    <Border Background="#fef2f2" CornerRadius="12" Padding="16,14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock x:Name="ItemCountInfo" Text="" FontSize="13" Foreground="#991b1b" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ItemBreakdown" Text="" FontSize="11" Foreground="#b91c1c" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="What would you like to do with the items?" FontSize="14" FontWeight="SemiBold" Foreground="#0f172a" Margin="0,0,0,16"/>

                    <!-- Option 1: Move to existing category -->
                    <RadioButton x:Name="OptionMoveExisting" GroupName="DeleteAction" Margin="0,0,0,12" Cursor="Hand"
                                 FontSize="13" Foreground="#334155" Checked="Option_Checked">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="📦 Move items to an existing category" FontWeight="SemiBold"/>
                            <TextBlock Text="All items will be reassigned to the selected category" FontSize="11" Foreground="#94a3b8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <ComboBox x:Name="ExistingCategoryCombo" Padding="12,9" FontSize="13" Margin="24,0,0,12"
                              Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5" IsEnabled="False">
                        <ComboBoxItem Content="— Select target category —" IsSelected="True"/>
                    </ComboBox>

                    <!-- Option 2: Move to new category -->
                    <RadioButton x:Name="OptionMoveNew" GroupName="DeleteAction" Margin="0,0,0,12" Cursor="Hand"
                                 FontSize="13" Foreground="#334155" Checked="Option_Checked">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="🏷 Create a new category and move items there" FontWeight="SemiBold"/>
                            <TextBlock Text="A new category will be created with the name you provide" FontSize="11" Foreground="#94a3b8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBox x:Name="NewCategoryNameBox" FontSize="13" Padding="12,9" Margin="24,0,0,12"
                             Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5" IsEnabled="False"
                             Text="" />

                    <!-- Option 3: Delete everything -->
                    <RadioButton x:Name="OptionDeleteAll" GroupName="DeleteAction" Margin="0,0,0,8" Cursor="Hand"
                                 FontSize="13" Foreground="#334155" Checked="Option_Checked">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="⚠ Delete all items in this category" FontWeight="SemiBold" Foreground="#dc2626"/>
                            <TextBlock Text="WARNING: This will permanently remove all inventory and menu items. This cannot be undone!" FontSize="11" Foreground="#ef4444" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,12,24,18" BorderBrush="#f1f5f9" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Width="100" Height="38" FontSize="13" FontWeight="SemiBold"
                        Background="#f1f5f9" Foreground="#475569" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="ConfirmButton" Content="🗑 Delete Category" Click="Confirm_Click" Width="160" Height="38"
                        FontSize="13" FontWeight="SemiBold" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#ef4444" Offset="0"/>
                            <GradientStop Color="#dc2626" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
