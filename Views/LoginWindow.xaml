<Window x:Class="RestaurantManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restaurant Manager - Sales Platform" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Accent color -->
        <Color x:Key="AccentColor">#764ba2</Color>
        <Color x:Key="AccentLight">#a78bfa</Color>
        <Color x:Key="AccentGlow">#667eea</Color>

        <!-- Rounded TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1e1e2e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#3a3a4a"/>
            <Setter Property="CaretBrush" Value="#a78bfa"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" PanningMode="Both" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#a78bfa"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                                <Setter Property="Background" Value="#252538"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1e1e2e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#3a3a4a"/>
            <Setter Property="CaretBrush" Value="#a78bfa"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" PanningMode="Both" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#a78bfa"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                                <Setter Property="Background" Value="#252538"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gradient Login Button -->
        <Style x:Key="GradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="12" Padding="20,14" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="20" Color="#667eea" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7b93ed" Offset="0"/>
                                            <GradientStop Color="#8b5fbf" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="btnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="30" Color="#764ba2" Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="btnBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Demo account button style -->
        <Style x:Key="DemoAccountBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8a8aaa"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="demoBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="demoBorder" Property="Background" Value="#1e1e30"/>
                                <Setter Property="Foreground" Value="#a78bfa"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="18" SnapsToDevicePixels="True">
                            <TextBlock Text="✕" FontSize="{TemplateBinding FontSize}" 
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#3a2020"/>
                                <Setter Property="Foreground" Value="#ff6b6b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fade-in storyboard -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainCard" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetName="MainCard" Storyboard.TargetProperty="Margin"
                                From="30,50,30,10" To="30" Duration="0:0:0.6">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Main Container with drop shadow -->
    <Border x:Name="MainCard" Margin="30" CornerRadius="20" Opacity="0"
            Background="#16162a" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT PANEL - Branding ==================== -->
            <Border x:Name="LeftPanel" Grid.Column="0" CornerRadius="20,0,0,20" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1a1040" Offset="0"/>
                        <GradientStop Color="#2d1b69" Offset="0.4"/>
                        <GradientStop Color="#11998e" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Decorative circles -->
                    <Ellipse Width="300" Height="300" Opacity="0.06" Fill="White"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-60,0,0"/>
                    <Ellipse Width="200" Height="200" Opacity="0.04" Fill="White"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-40"/>
                    <Ellipse Width="120" Height="120" Opacity="0.05" Fill="White"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,80"/>

                    <!-- Content -->
                    <StackPanel VerticalAlignment="Center" Margin="50,0">
                        <!-- Logo -->
                        <Border Width="80" Height="80" CornerRadius="20" Margin="0,0,0,30"
                                HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#ffffff" Offset="0"/>
                                    <GradientStop Color="#e0e0ff" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock x:Name="LogoText" Text="🍽️" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="LogoImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="BrandLine1" Text="R E S T A U R A N T" FontSize="18" FontWeight="Light" Foreground="#c0c0e0" 
                                   Margin="0,0,0,0"/>
                        <TextBlock x:Name="BrandLine2" Text="Manager" FontSize="42" FontWeight="Bold" Foreground="White" 
                                   Margin="0,-4,0,20">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="15" Color="#764ba2" Opacity="0.4"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Border Height="3" Width="60" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,25">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#11998e" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBlock x:Name="TaglineText" Text="Restaurant Sales &amp; Management" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#c8c8f0" Margin="0,0,0,14"/>
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="13" Foreground="#9090b8" LineHeight="22"
                                   Text="Manage orders, inventory, staff, and sales — all from one dashboard. Built for efficiency."/>

                        <!-- Stats -->
                        <StackPanel Orientation="Horizontal" Margin="0,40,0,0">
                            <Border x:Name="Pill1Bg" Background="#ffffff10" CornerRadius="12" Padding="18,12" Margin="0,0,12,0">
                                <TextBlock x:Name="Pill1Text" Text="📋 Orders" FontSize="12" Foreground="#b0b0d0" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Pill2Bg" Background="#ffffff10" CornerRadius="12" Padding="18,12" Margin="0,0,12,0">
                                <TextBlock x:Name="Pill2Text" Text="📦 Inventory" FontSize="12" Foreground="#b0b0d0" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Pill3Bg" Background="#ffffff10" CornerRadius="12" Padding="18,12">
                                <TextBlock x:Name="Pill3Text" Text="📊 Reports" FontSize="12" Foreground="#b0b0d0" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom branding -->
                    <StackPanel VerticalAlignment="Bottom" Margin="50,0,0,30">
                        <TextBlock x:Name="CopyrightText"
                                   Text="© 2026 Restaurant Manager" FontSize="11" Foreground="#6060a0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== RIGHT PANEL - Login Form ==================== -->
            <Border x:Name="RightPanel" Grid.Column="1" CornerRadius="0,20,20,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#16162a" Offset="0"/>
                        <GradientStop Color="#1a1a35" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Close Button -->
                    <Button Style="{StaticResource CloseBtn}" Click="CloseBtn_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"/>

                    <StackPanel VerticalAlignment="Center" Margin="44,0">

                        <!-- Welcome text -->
                        <TextBlock x:Name="WelcomeTitleText" Text="Welcome back" FontSize="28" FontWeight="Bold" Foreground="White" 
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="WelcomeSubtitleText" Text="Sign in to your account to continue" FontSize="13" 
                                   Foreground="#7a7a9a" Margin="0,0,0,36"/>

                        <!-- Email Field -->
                        <TextBlock x:Name="EmailLabelText" Text="EMAIL" FontSize="11" FontWeight="SemiBold" Foreground="#6a6a8a" 
                                   Margin="4,0,0,8"/>
                        <TextBox x:Name="EmailBox"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,22"/>

                        <!-- Password Field -->
                        <TextBlock x:Name="PasswordLabelText" Text="PASSWORD" FontSize="11" FontWeight="SemiBold" Foreground="#6a6a8a" 
                                   Margin="4,0,0,8"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,10"/>

                        <!-- Error Message -->
                        <TextBlock x:Name="ErrorMessage" Foreground="#ff6b6b" FontSize="12" 
                                   Margin="4,0,0,6" TextWrapping="Wrap" FontWeight="SemiBold"
                                   MinHeight="20"/>

                        <!-- Login Button -->
                        <Button x:Name="LoginButton" Click="LoginBtn_Click" IsDefault="True"
                                Style="{StaticResource GradientButton}" Margin="0,4,0,0"/>

                        <!-- Loading indicator (hidden by default) -->
                        <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" 
                                    Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="⏳" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Signing in..." FontSize="12" Foreground="#a78bfa" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="DemoAccountsSection" Visibility="Collapsed">
                        <!-- Divider -->
                        <Grid Margin="0,28,0,20">
                            <Border Height="1" Background="#2a2a44" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QuickLoginLabel" Text="QUICK LOGIN" FontSize="10" Foreground="#5a5a7a" 
                                       Background="#1a1a32" Padding="12,0" HorizontalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Dynamic Account Buttons (populated from database) -->
                        <Border Background="#12122a" CornerRadius="14" Padding="6" BorderBrush="#2a2a44" BorderThickness="1">
                            <StackPanel x:Name="DemoAccountsList"/>
                        </Border>

                        <TextBlock x:Name="DemoPasswordHint" Text="Password for all: password" FontSize="10" Foreground="#4a4a6a" 
                                   FontStyle="Italic" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Trademark footer -->
                    <TextBlock x:Name="TrademarkFooterRight" Text="Powered by Restaurant Manager"
                               FontSize="9" Foreground="#4a4a6a" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
