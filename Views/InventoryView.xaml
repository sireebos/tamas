<UserControl x:Class="RestaurantManager.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InvCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="16" Color="#000" Opacity="0.07"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvInput" TargetType="TextBox">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style x:Key="InvBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon-only action button -->
        <Style x:Key="IconAction" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f0f2f5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER + STATS ═══════════ -->
        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <!-- Title Row -->
            <Grid Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="14" Width="46" Height="46" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#667eea" Offset="0"/>
                                <GradientStop Color="#764ba2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Inventory Management" FontSize="24" FontWeight="Bold" Foreground="#0f172a"/>
                        <TextBlock Text="Track stock levels, manage items, and monitor supplies" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource InvBtn}" Click="ImportBtn_Click" Margin="0,0,8,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#f59e0b" Offset="0"/>
                                <GradientStop Color="#d97706" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Import" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource InvBtn}" Click="ExportBtn_Click" Margin="0,0,8,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10b981" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📤" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource InvBtn}" Click="AddItem_Click" Margin="0,0,8,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#667eea" Offset="0"/>
                                <GradientStop Color="#764ba2" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Item" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource InvBtn}" Background="#64748b" Click="RefreshBtn_Click" Padding="14,0">
                        <TextBlock Text="↻" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ GRADIENT SUMMARY CARDS ═══ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Items Card -->
                <Border x:Name="InvCard1" Grid.Column="0" CornerRadius="16" Padding="20,18" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="InvCard1Stop1" Color="#667eea" Offset="0"/>
                            <GradientStop x:Name="InvCard1Stop2" Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Color="#667eea" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <!-- Watermark icon — rendered FIRST so it stays BEHIND the text -->
                        <TextBlock Text="📦" FontSize="48" Opacity="0.15"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-8"/>
                        <!-- Content on top -->
                        <StackPanel>
                            <TextBlock x:Name="InvCard1Label" Text="Total Items" FontSize="11" Foreground="#ffffffcc" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TotalItemsText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TotalCategoriesText" Text="0 categories" FontSize="10" Foreground="#ffffffaa" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Low Stock Card -->
                <Border x:Name="InvCard2" Grid.Column="2" CornerRadius="16" Padding="20,18" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="InvCard2Stop1" Color="#f97316" Offset="0"/>
                            <GradientStop x:Name="InvCard2Stop2" Color="#ea580c" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Color="#f97316" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="⚠️" FontSize="48" Opacity="0.15"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-8"/>
                        <StackPanel>
                            <TextBlock x:Name="InvCard2Label" Text="Low Stock" FontSize="11" Foreground="#ffffffcc" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LowStockText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock x:Name="InvCard2Sub" Text="below minimum" FontSize="10" Foreground="#ffffffaa" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Out of Stock Card -->
                <Border x:Name="InvCard3" Grid.Column="4" CornerRadius="16" Padding="20,18" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="InvCard3Stop1" Color="#ef4444" Offset="0"/>
                            <GradientStop x:Name="InvCard3Stop2" Color="#dc2626" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Color="#ef4444" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="🚫" FontSize="48" Opacity="0.15"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-8"/>
                        <StackPanel>
                            <TextBlock x:Name="InvCard3Label" Text="Out of Stock" FontSize="11" Foreground="#ffffffcc" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OutOfStockText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock x:Name="InvCard3Sub" Text="needs reorder" FontSize="10" Foreground="#ffffffaa" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Stock Value Card -->
                <Border x:Name="InvCard4" Grid.Column="6" CornerRadius="16" Padding="20,18" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="InvCard4Stop1" Color="#22c55e" Offset="0"/>
                            <GradientStop x:Name="InvCard4Stop2" Color="#16a34a" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="14" Color="#22c55e" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="💰" FontSize="48" Opacity="0.15"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-8"/>
                        <StackPanel>
                            <TextBlock x:Name="InvCard4Label" Text="Stock Value" FontSize="11" Foreground="#ffffffcc" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StockValueText" Text="₦ 0.00" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock x:Name="InvCard4Sub" Text="total value" FontSize="10" Foreground="#ffffffaa" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ FILTERS BAR ═══ -->
            <Border Style="{StaticResource InvCard}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <!-- Search -->
                        <Border Background="#f8fafc" CornerRadius="10" BorderBrush="#e2e8f0" BorderThickness="1.5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <TextBox x:Name="SearchBox" Width="200" Padding="4,10" FontSize="12" 
                                         Background="Transparent" BorderThickness="0" Foreground="#1e293b"
                                         TextChanged="SearchBox_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="#1e293b"/>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Border>

                        <!-- Category Filter -->
                        <Border Background="#f8fafc" CornerRadius="10" BorderBrush="#e2e8f0" BorderThickness="1.5" Padding="10,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CategoryFilter" Width="130" Padding="4,9" FontSize="11" 
                                          Background="Transparent" BorderThickness="0" SelectionChanged="CategoryFilter_Changed">
                                    <ComboBoxItem Content="All Categories" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Status Filter -->
                        <Border Background="#f8fafc" CornerRadius="10" BorderBrush="#e2e8f0" BorderThickness="1.5" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="StatusFilter" Width="120" Padding="4,9" FontSize="11" 
                                          Background="Transparent" BorderThickness="0" SelectionChanged="StatusFilter_Changed">
                                    <ComboBoxItem Content="All Items" IsSelected="True"/>
                                    <ComboBoxItem Content="Low Stock"/>
                                    <ComboBoxItem Content="Out of Stock"/>
                                    <ComboBoxItem Content="Well Stocked"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Background="#eff6ff" CornerRadius="8" Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ResultCountText" Text="0 items" FontSize="11" Foreground="#667eea" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ SELECTION ACTION BAR ═══ -->
            <Border x:Name="SelectionBar" Visibility="Collapsed" Background="#f8fafc" CornerRadius="14" Padding="14,10" Margin="0,0,0,16"
                    BorderBrush="#e2e8f0" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="8" Color="#000" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#eff6ff" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                            <TextBlock Text="☑" FontSize="14" Foreground="#667eea" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="SelectedCountText" Text="0 items selected" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource InvBtn}" Background="#fef2f2" Foreground="#ef4444" Click="DeleteSelected_Click" Height="34" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Delete Selected" FontSize="11" Foreground="#ef4444" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource InvBtn}" Background="#f1f5f9" Click="CancelSelection_Click" Height="34" Padding="14,0" Margin="8,0,0,0">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#64748b" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════════ INVENTORY TABLE ═══════════ -->
        <Border Grid.Row="1" Margin="28,0,28,28" Style="{StaticResource InvCard}" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True"
                      Background="White" Foreground="#334155"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#f1f5f9"
                      BorderThickness="0" RowHeight="58"
                      AlternationCount="2"
                      HorizontalScrollBarVisibility="Disabled"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#f8fafc"/>
                        <Setter Property="Foreground" Value="#64748b"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Padding" Value="14,14"/>
                        <Setter Property="BorderBrush" Value="#e2e8f0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#fafbfe"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#eff6ff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f0f4ff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#334155"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <!-- Select Checkbox -->
                    <DataGridTemplateColumn Width="42">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#f8fafc"/>
                                <Setter Property="Padding" Value="0,14"/>
                                <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="0" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Item Name with category icon -->
                    <DataGridTemplateColumn Header="ITEM NAME" Width="*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#f0f4ff" CornerRadius="10" Width="36" Height="36" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding CategoryIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="200">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0f172a" FontSize="12.5" 
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#94a3b8" 
                                                   TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTip="{Binding Description}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Category Badge -->
                    <DataGridTemplateColumn Header="CATEGORY" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#f0f4ff" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Category}" Foreground="#667eea" FontWeight="Bold" FontSize="10"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SubCategory Badge -->
                    <DataGridTemplateColumn Header="SUB-CATEGORY" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left"
                                        Visibility="{Binding SubCategory, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding SubCategory}" Foreground="#64748b" FontWeight="SemiBold" FontSize="10"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Stock with dynamic progress -->
                    <DataGridTemplateColumn Header="STOCK" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Quantity}" FontWeight="Bold" FontSize="13" Foreground="#0f172a"/>
                                        <TextBlock Text=" / " FontSize="9" Foreground="#94a3b8" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                        <TextBlock Text="{Binding MinLevel}" FontSize="9" Foreground="#94a3b8" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                        <TextBlock Text="{Binding Unit}" FontSize="9" Foreground="#94a3b8" VerticalAlignment="Bottom" Margin="3,0,0,1"/>
                                    </StackPanel>
                                    <Grid Height="5" Width="90" HorizontalAlignment="Left">
                                        <Border Background="#e2e8f0" CornerRadius="3"/>
                                        <Border Background="{Binding StockBarBrush}" CornerRadius="3" HorizontalAlignment="Left"
                                                Width="{Binding StockBarWidth}"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Dynamic Status Badge -->
                    <DataGridTemplateColumn Header="STATUS" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBackground}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontWeight="Bold" FontSize="10"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cost/Unit -->
                    <DataGridTemplateColumn Header="COST" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedCost}" FontWeight="SemiBold" Foreground="#475569" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Value -->
                    <DataGridTemplateColumn Header="VALUE" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedValue}" FontWeight="Bold" Foreground="#22c55e" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions - compact icon buttons -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource IconAction}" Background="#eff6ff" ToolTip="Edit item"
                                            Tag="{Binding Id}" Click="EditItem_Click">
                                        <TextBlock Text="✏" FontSize="14" Foreground="#667eea" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource IconAction}" Background="#fff7ed" ToolTip="Adjust stock"
                                            Tag="{Binding Id}" Click="AdjustStock_Click" Margin="6,0">
                                        <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource IconAction}" Background="#fef2f2" ToolTip="Delete item"
                                            Tag="{Binding Id}" Click="DeleteItem_Click">
                                        <TextBlock Text="🗑" FontSize="14" Foreground="#ef4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══════════ ADD/EDIT DIALOG OVERLAY ═══════════ -->
        <Grid x:Name="DialogOverlay" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="#000" Opacity="0.5" MouseDown="CloseDialog_Click"/>
            <Border Width="540" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="22" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="10" BlurRadius="40" Color="#000" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header gradient -->
                    <Border Grid.Row="0" Padding="28,22,28,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#667eea" Offset="0"/>
                                <GradientStop Color="#764ba2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="DialogTitle" Text="Add New Item" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Fill in the details below" FontSize="11" Foreground="#ffffffaa" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#ffffffcc"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="CloseDialog_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" Padding="28,22,28,26">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Name -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                                    <TextBlock Text="Item Name" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBlock Text="The product or ingredient name (e.g. Coca-Cola, Chicken Wings)" FontSize="9" Foreground="#94a3b8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DlgName" Style="{StaticResource InvInput}"/>
                                </StackPanel>

                                <!-- Category + SubCategory -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock Text="Category" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBlock Text="Group this item belongs to" FontSize="9" Foreground="#94a3b8" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="DlgCategory" Padding="14,12" FontSize="13" IsEditable="True"
                                              Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5"
                                              SelectionChanged="DlgCategory_SelectionChanged" TextBoxBase.TextChanged="DlgCategory_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                    <TextBlock Text="Sub-Category" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBlock Text="Sub-group (Optional)" FontSize="9" Foreground="#94a3b8" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="DlgSubCategory" Padding="14,12" FontSize="13" IsEditable="True"
                                              Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1.5"/>
                                </StackPanel>

                                <!-- Unit + Quantity -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock Text="Unit" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBlock Text="Measurement unit (pcs, kg, etc.)" FontSize="9" Foreground="#94a3b8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DlgUnit" Style="{StaticResource InvInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                                    <TextBlock Text="Quantity" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBlock Text="Current stock available" FontSize="9" Foreground="#94a3b8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DlgQuantity" Style="{StaticResource InvInput}"/>
                                </StackPanel>

                                <!-- Cost + Min Level -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock x:Name="DlgCostLabel" Text="Cost Price" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBlock Text="Price per unit" FontSize="9" Foreground="#94a3b8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DlgCostPrice" Style="{StaticResource InvInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                                    <TextBlock Text="Min Stock Level" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBlock Text="Alert when below this" FontSize="9" Foreground="#94a3b8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DlgMinLevel" Style="{StaticResource InvInput}"/>
                                </StackPanel>

                                <!-- Reorder Qty -->
                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock Text="Reorder Quantity" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBlock Text="Qty to restock" FontSize="9" Foreground="#94a3b8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DlgReorderQty" Style="{StaticResource InvInput}"/>
                                </StackPanel>

                                <!-- Description -->
                                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                    <TextBlock Text="Description" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBlock Text="Optional notes (supplier, brand, etc.)" FontSize="9" Foreground="#94a3b8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DlgDescription" Style="{StaticResource InvInput}" Height="60" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dialog Buttons -->
                            <Grid>
                                <TextBlock x:Name="DlgStatus" Text="" FontSize="11" Foreground="#ef4444" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{StaticResource InvBtn}" Background="#e2e8f0" Foreground="#475569"
                                            Click="CloseDialog_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="DlgSaveBtn" Content="Save Item" Style="{StaticResource InvBtn}" Click="SaveItem_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#667eea" Offset="0"/>
                                                <GradientStop Color="#764ba2" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ STOCK ADJUST DIALOG ═══════════ -->
        <Grid x:Name="AdjustOverlay" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="#000" Opacity="0.5" MouseDown="CloseAdjust_Click"/>
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="22" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="10" BlurRadius="40" Color="#000" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="24,20,24,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22c55e" Offset="0"/>
                                <GradientStop Color="#16a34a" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Adjust Stock" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="AdjustItemName" Text="" FontSize="12" Foreground="#ffffffbb" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" Padding="24,22,24,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#f8fafc" CornerRadius="14" Padding="14,12">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Current Stock" FontSize="10" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="AdjustCurrentQty" Text="0" FontSize="26" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" Text="+" FontSize="22" FontWeight="Bold" Foreground="#22c55e" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#f0fdf4" CornerRadius="14" Padding="14,12">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Add Quantity" FontSize="10" FontWeight="SemiBold" Foreground="#16a34a" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="AdjustNewQty" Style="{StaticResource InvInput}" FontSize="18" FontWeight="Bold"
                                                 HorizontalAlignment="Stretch" TextAlignment="Center" Margin="0,4,0,0" Background="Transparent"
                                                 BorderBrush="#22c55e"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource InvBtn}" Background="#e2e8f0" Foreground="#475569"
                                        Click="CloseAdjust_Click" Margin="0,0,10,0"/>
                                <Button Content="Update Stock" Style="{StaticResource InvBtn}" Click="ConfirmAdjust_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#22c55e" Offset="0"/>
                                            <GradientStop Color="#16a34a" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
