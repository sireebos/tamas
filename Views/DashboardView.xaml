<UserControl x:Class="RestaurantManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Card Base Style -->
        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="12" Color="#000000" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Title -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Small Label -->
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
        </Style>

        <!-- Quick Action Button -->
        <Style x:Key="QuickActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f8fafc"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Badge Template -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="Both" Background="#f1f5f9">
        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ ROW 0: Header ═══════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="GreetingText" Text="Good morning," FontSize="14" Foreground="#64748b" Margin="0,0,0,4"/>
                    <TextBlock x:Name="UserNameText" Text="" FontSize="28" FontWeight="Bold" Foreground="#0f172a"/>
                    <TextBlock x:Name="DateText" Text="" FontSize="12" Foreground="#94a3b8" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource DashCard}" Padding="20,14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#22c55e" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="System Online" FontSize="12" FontWeight="SemiBold" Foreground="#22c55e" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  " Foreground="#cbd5e1" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SyncStatusText" Text="Local Mode" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════ ROW 1: Stat Cards ═══════════ -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Revenue Card -->
                <Border Grid.Column="0" CornerRadius="16" Padding="24" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="DashCard1Stop1" Color="#667eea" Offset="0"/>
                            <GradientStop x:Name="DashCard1Stop2" Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="16" Color="#667eea" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="DashCard1Label" Text="TODAY'S REVENUE" FontSize="10" FontWeight="Bold" Foreground="#c7d2fe" Margin="0,0,0,10"/>
                            <TextBlock x:Name="RevenueValue" Text="R 0.00" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="RevenueTrend" Text="▲ 0%" FontSize="11" Foreground="#a5f3fc" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DashCard1Sub" Text=" vs yesterday" FontSize="11" Foreground="#c7d2fe"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="💰" FontSize="40" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"/>
                    </Grid>
                </Border>

                <!-- Today's Orders Card -->
                <Border Grid.Column="2" CornerRadius="16" Padding="24" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="DashCard2Stop1" Color="#f97316" Offset="0"/>
                            <GradientStop x:Name="DashCard2Stop2" Color="#ef4444" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="16" Color="#f97316" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="DashCard2Label" Text="TODAY'S ORDERS" FontSize="10" FontWeight="Bold" Foreground="#fed7aa" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TodayOrdersValue" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TodayRevenueText" Text="R 0.00 today" FontSize="11" Foreground="#fde68a" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🔥" FontSize="40" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"/>
                    </Grid>
                </Border>

                <!-- Total Orders Card -->
                <Border Grid.Column="4" CornerRadius="16" Padding="24" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="DashCard3Stop1" Color="#10b981" Offset="0"/>
                            <GradientStop x:Name="DashCard3Stop2" Color="#059669" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="16" Color="#10b981" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="DashCard3Label" Text="COMPLETED TODAY" FontSize="10" FontWeight="Bold" Foreground="#a7f3d0" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TotalOrdersValue" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                            <TextBlock x:Name="AvgOrderText" Text="Avg: R 0.00" FontSize="11" Foreground="#bbf7d0" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Text="📦" FontSize="40" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"/>
                    </Grid>
                </Border>

                <!-- Low Stock Card -->
                <Border Grid.Column="6" CornerRadius="16" Padding="24" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="DashCard4Stop1" Color="#8b5cf6" Offset="0"/>
                            <GradientStop x:Name="DashCard4Stop2" Color="#6d28d9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="16" Color="#8b5cf6" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="DashCard4Label" Text="INVENTORY" FontSize="10" FontWeight="Bold" Foreground="#ddd6fe" Margin="0,0,0,10"/>
                            <TextBlock x:Name="InventoryValue" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="LowStockBadge" Text="⚠ 0 low stock" FontSize="11" Foreground="#fde68a" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="📊" FontSize="40" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════ ROW 2: Order Status + Quick Actions ═══════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Order Status Breakdown -->
                <Border Grid.Column="0" Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="Order Status Overview" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pending -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Border Background="#fef3c7" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⏳" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="PendingCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#92400e" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Pending" FontSize="11" FontWeight="SemiBold" Foreground="#92400e" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Preparing -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <Border Background="#dbeafe" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="👨‍🍳" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="PreparingCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1e40af" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Preparing" FontSize="11" FontWeight="SemiBold" Foreground="#1e40af" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Completed -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <Border Background="#d1fae5" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="✅" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="CompletedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#065f46" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Completed" FontSize="11" FontWeight="SemiBold" Foreground="#065f46" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Cancelled -->
                            <StackPanel Grid.Column="3">
                                <Border Background="#fee2e2" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="❌" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="CancelledCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#991b1b" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Cancelled" FontSize="11" FontWeight="SemiBold" Foreground="#991b1b" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Grid.Column="2" Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" Style="{StaticResource SectionTitle}"/>
                        <Button Style="{StaticResource QuickActionBtn}" Click="NewOrder_Click" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="New Order" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionBtn}" Click="ViewOrders_Click" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="View All Orders" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionBtn}" Click="ViewInventory_Click" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Check Inventory" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionBtn}" Click="RefreshDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Refresh Dashboard" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════ ROW 3: Recent Orders + Low Stock Alerts ═══════════ -->
            <Grid Grid.Row="3" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recent Orders -->
                <Border Grid.Column="0" Style="{StaticResource DashCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Recent Orders" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock x:Name="OrderCountLabel" Text="Last 8 orders" FontSize="11" Foreground="#94a3b8"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border CornerRadius="12" ClipToBounds="True" BorderBrush="#e2e8f0" BorderThickness="1">
                            <DataGrid x:Name="RecentOrdersGrid" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True" 
                                      Background="White" Foreground="#334155"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#f1f5f9"
                                      BorderThickness="0" RowHeight="46"
                                      MaxHeight="380">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#f8fafc"/>
                                        <Setter Property="Foreground" Value="#64748b"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="16,12"/>
                                        <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#f8fafc"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="16,0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ORDER #" Binding="{Binding OrderNumber}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#667eea"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ITEMS" Binding="{Binding Items.Count}" Width="70"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding FormattedTotal}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#0f172a"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat='{}{0:MMM dd, HH:mm}'}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Low Stock Alerts -->
                <Border Grid.Column="2" Style="{StaticResource DashCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Low Stock Alerts" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="⚠" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="LowStockList" MaxHeight="380">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#fefce8" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1e293b"/>
                                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#94a3b8">
                                                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                    <Run Text="/"/>
                                                    <Run Text="{Binding MinLevel, Mode=OneWay}"/>
                                                    <Run Text="{Binding Unit, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                            <!-- Stock level bar -->
                                            <Grid Height="6">
                                                <Border Background="#fde68a" CornerRadius="3"/>
                                                <Border x:Name="StockBar" Background="#ef4444" CornerRadius="3" HorizontalAlignment="Left"
                                                        Width="20"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoLowStockText" Text="✓ All items well stocked!" FontSize="13" 
                                   Foreground="#22c55e" FontWeight="SemiBold" HorizontalAlignment="Center" 
                                   Margin="0,20,0,20" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════ ROW 4: Activity Summary ═══════════ -->
            <Border Grid.Row="4" Style="{StaticResource DashCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Today's Summary -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="📅 Today's Summary" FontSize="13" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,14"/>
                        <Border Background="#f0fdf4" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Completed Orders" FontSize="12" Foreground="#166534"/>
                                <TextBlock x:Name="TodayCompletedText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Background="#fef9c3" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Pending Orders" FontSize="12" Foreground="#854d0e"/>
                                <TextBlock x:Name="TodayPendingText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#854d0e" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Background="#eff6ff" CornerRadius="10" Padding="14,10">
                            <Grid>
                                <TextBlock Text="Avg. Order Value" FontSize="12" Foreground="#1e40af"/>
                                <TextBlock x:Name="TodayAvgText" Text="R 0.00" FontSize="12" FontWeight="Bold" Foreground="#1e40af" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Performance -->
                    <StackPanel Grid.Column="1" Margin="16,0">
                        <TextBlock Text="📈 Performance" FontSize="13" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,14"/>
                        <Border Background="#faf5ff" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="This Week" FontSize="12" Foreground="#6b21a8"/>
                                <TextBlock x:Name="WeekOrdersText" Text="0 orders" FontSize="12" FontWeight="Bold" Foreground="#6b21a8" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Background="#fff7ed" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="This Month" FontSize="12" Foreground="#9a3412"/>
                                <TextBlock x:Name="MonthOrdersText" Text="0 orders" FontSize="12" FontWeight="Bold" Foreground="#9a3412" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Background="#f0f9ff" CornerRadius="10" Padding="14,10">
                            <Grid>
                                <TextBlock Text="Monthly Revenue" FontSize="12" Foreground="#075985"/>
                                <TextBlock x:Name="MonthRevenueText" Text="R 0.00" FontSize="12" FontWeight="Bold" Foreground="#075985" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- System Info -->
                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                        <TextBlock Text="⚙️ System Info" FontSize="13" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,14"/>
                        <Border Background="#f8fafc" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Role" FontSize="12" Foreground="#475569"/>
                                <TextBlock x:Name="UserRoleText" Text="" FontSize="12" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Background="#f8fafc" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Department" FontSize="12" Foreground="#475569"/>
                                <TextBlock x:Name="UserDeptText" Text="" FontSize="12" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Background="#f8fafc" CornerRadius="10" Padding="14,10">
                            <Grid>
                                <TextBlock Text="Database" FontSize="12" Foreground="#475569"/>
