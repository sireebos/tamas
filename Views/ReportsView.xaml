<UserControl x:Class="RestaurantManager.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f8fafc" Loaded="ReportsView_Loaded">
 
    <UserControl.Resources>
        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="6" Color="#000" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
 
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
 
        <!-- ═══════════ HEADER BAR ═══════════ -->
        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
 
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📈" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reports &amp; Analytics" FontSize="20" FontWeight="Bold" Foreground="#0f172a"/>
                        <TextBlock x:Name="ReportPeriodLabel" Text="" FontSize="11" Foreground="#94a3b8"/>
                    </StackPanel>
                </StackPanel>
 
                <!-- ═══════════ FILTERS ═══════════ -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#f1f5f9" CornerRadius="10" Padding="3" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FilterToday" Style="{StaticResource FilterBtn}" Content="Today" Tag="today" Click="FilterBtn_Click" Margin="0,0,2,0"/>
                            <Button x:Name="FilterWeek" Style="{StaticResource FilterBtn}" Content="Week" Tag="week" Click="FilterBtn_Click" Margin="0,0,2,0"/>
                            <Button x:Name="FilterMonth" Style="{StaticResource FilterBtn}" Content="Month" Tag="month" Click="FilterBtn_Click" Margin="0,0,2,0"/>
                            <Button x:Name="FilterYear" Style="{StaticResource FilterBtn}" Content="Year" Tag="year" Click="FilterBtn_Click"/>
                        </StackPanel>
                    </Border>
                    
                    <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="From:" VerticalAlignment="Center" FontSize="11" Foreground="#94a3b8" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DateFrom" Width="120" SelectedDateChanged="DateRange_Changed"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" FontSize="11" Foreground="#94a3b8" Margin="10,0,6,0"/>
                        <DatePicker x:Name="DateTo" Width="120" SelectedDateChanged="DateRange_Changed"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource FilterBtn}" Click="OpenReportCenter_Click" Padding="14,0" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Print Report" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Height="24" Width="1" Background="#e2e8f0" Margin="2,0,8,0"/>
                    <Button x:Name="ExportCsvBtn" Style="{StaticResource FilterBtn}" Click="ExportReport_Click" Padding="14,0" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CSV" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportPdfBtn" Style="{StaticResource FilterBtn}" Click="ExportPdf_Click" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PDF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
 
        <!-- ═══════════ SCROLLABLE CONTENT ═══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
            <StackPanel>
 
                <!-- ─── ROW 1: Summary Cards ─── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <!-- Total Revenue -->
                    <Border Grid.Column="0" CornerRadius="14" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#667eea" Offset="0"/>
                                <GradientStop Color="#764ba2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Total Revenue" FontSize="12" Foreground="#ffffffbb"/>
                            <TextBlock x:Name="TotalRevenueText" Text="₦ 0.00" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock x:Name="RevenueCompare" Text="" FontSize="11" Foreground="#ffffffaa" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
 
                    <!-- Total Orders -->
                    <Border Grid.Column="2" CornerRadius="14" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22c55e" Offset="0"/>
                                <GradientStop Color="#16a34a" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Total Orders" FontSize="12" Foreground="#ffffffbb"/>
                            <TextBlock x:Name="TotalOrdersText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock x:Name="OrdersCompletedText" Text="" FontSize="11" Foreground="#ffffffaa" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
 
                    <!-- Average Order -->
                    <Border Grid.Column="4" CornerRadius="14" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#f59e0b" Offset="0"/>
                                <GradientStop Color="#d97706" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Average Order" FontSize="12" Foreground="#ffffffbb"/>
                            <TextBlock x:Name="AvgOrderText" Text="₦ 0.00" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock x:Name="AvgOrderSub" Text="" FontSize="11" Foreground="#ffffffaa" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
 
                    <!-- Items Sold -->
                    <Border Grid.Column="6" CornerRadius="14" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0ea5e9" Offset="0"/>
                                <GradientStop Color="#0284c7" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Items Sold" FontSize="12" Foreground="#ffffffbb"/>
                            <TextBlock x:Name="TotalItemsSoldText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ItemsSoldSub" Text="" FontSize="11" Foreground="#ffffffaa" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
 
                <!-- ─── ROW 2: Revenue Chart + Payment Breakdown ─── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <!-- Revenue Chart -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Revenue Trend" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                            <Border x:Name="ChartArea" Height="220" Background="#f8fafc" CornerRadius="8" ClipToBounds="True">
                                <Canvas x:Name="RevenueChart"/>
                            </Border>
                        </StackPanel>
                    </Border>
 
                    <!-- Payment Method Breakdown -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Payment Methods" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                            <StackPanel x:Name="PaymentBreakdownPanel"/>
                        </StackPanel>
                    </Border>
                </Grid>
 
                <!-- ─── ROW 3: Top Selling Items + Order Status ─── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <!-- Top Selling Items -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Top Selling Items" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                            <StackPanel x:Name="TopItemsPanel"/>
                        </StackPanel>
                    </Border>
 
                    <!-- Order Status Breakdown -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Order Status" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                            <StackPanel x:Name="OrderStatusPanel"/>
                        </StackPanel>
                    </Border>
                </Grid>
 
                <!-- ─── ROW 4: Sales by Category + Peak Hours ─── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <!-- Sales by Category -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Sales by Category" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                            <StackPanel x:Name="CategorySalesPanel"/>
                        </StackPanel>
                    </Border>
 
                    <!-- Peak Hours -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Peak Hours" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                            <StackPanel x:Name="PeakHoursPanel"/>
                        </StackPanel>
                    </Border>
                </Grid>
 
                <!-- ─── ROW 5: Staff Performance + Daily Breakdown Table ─── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <!-- Staff Performance -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Staff Performance" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                            <StackPanel x:Name="StaffPerformancePanel"/>
                        </StackPanel>
                    </Border>
 
                    <!-- Daily Breakdown -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Daily Breakdown" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,12"/>
                            <StackPanel x:Name="DailyBreakdownPanel"/>
                        </StackPanel>
                    </Border>
                </Grid>
 
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
